{
	admin 0.0.0.0:2019

	servers :443 {
		name {{ .CaddyServerName }}
	}
}

:443 {
	# Seed the routes array so it is never empty.
	handle /internal/health {
		respond "OK" 200
	}

	tls internal
}

# Internal health check endpoint (bypasses automatic HTTPS redirection).
:8080 {
	respond /health "OK" 200
}

# Routes for worker service endpoints are registered dynamically via the
# Caddy Admin API by the control-plane deployer over the gRPC agent stream.
